{
  "name": "PicPortal",
  "version": "0.1.0",
  "description": "Images management/classification IO software",
  "author": {
    "name": "Proladon",
    "url": "https://github.com/Proladon"
  },
  "repository": {
    "url": "https://github.com/Proladon/PicPortal"
  },
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "buildEnvTypes": "node scripts/buildEnvTypes.js",
    "dev": "tauri dev",
    "prebuild": "npm run version:check",
    "build": "tauri build",
    "build:installer": "npm run build -- --bundles nsis --ci -- --locked",
    "dev:renderer": "cross-env MODE=development vite --config packages/renderer/vite.config.js",
    "build:renderer": "cross-env MODE=production vite build --config packages/renderer/vite.config.js",
    "tauri": "tauri",
    "pretest": "npm run version:check",
    "test": "npm run test:tauri-adapter && npm run test:batch && npm run test:tauri-ci",
    "test:tauri-adapter": "node tests/tauri-adapter.spec.cjs",
    "test:batch": "node tests/batch.spec.cjs",
    "test:tauri-ci": "node tests/tauri-browse.cjs --ci",
    "test:tauri-installer": "node tests/tauri-browse.cjs --ci --installer",
    "test:tauri-browse": "node tests/tauri-browse.cjs",
    "test:tauri-write": "node tests/tauri-browse.cjs --write",
    "test:tauri-interactions": "node tests/tauri-browse.cjs --interactions",
    "test:tauri-drops": "node tests/tauri-browse.cjs --drops",
    "test:tauri-skeleton": "node tests/tauri-skeleton.cjs",
    "test:tauri-skeleton:built": "node tests/tauri-skeleton.cjs --built",
    "version:check": "node scripts/tauri-version.cjs",
    "version:sync": "node scripts/tauri-version.cjs --write",
    "lint": "eslint . --ext js,ts,vue",
    "pretypecheck": "npm run buildEnvTypes",
    "typecheck": "vue-tsc --noEmit -p packages/renderer/tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/lodash": "^4.14.182",
    "@types/lodash-es": "^4.17.12",
    "@types/path-browserify": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/eslint-config-typescript": "9.1.0",
    "cross-env": "^7.0.3",
    "esbuild": "0.15.18",
    "eslint": "^7.32.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-vue": "^8.6.0",
    "prettier": "^2.2.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.16.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.53.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hotkeys-js": "^3.10.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^3.3.3",
    "p-queue": "^7.2.0",
    "path-browserify": "^1.0.1",
    "pinia": "^2.0.23",
    "pretty-browser-log": "^1.0.8",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "v-viewer": "^3.0.10",
    "vue": "^3.5.13",
    "vue-i18n": "9",
    "vue-router": "4.0.11",
    "vue-sonner": "^2.0.9",
    "vue3-virtual-list": "^1.0.2",
    "vuedraggable": "^4.1.0"
  }
}
